# Reference list of the variables this plugin uses.
#
# You normally never touch this file, or .env. Hermes collects these itself: the
# plugin declares them in plugin.yaml, so `hermes plugins install` / `enable`
# prompts for the two it cannot run without, and the bundled skill declares all
# four so Hermes can prompt at the moment of use too.
#
# To change a value later:
#
#     hermes config set THREADS_ACCESS_TOKEN "THQW..."
#
# ...or use the Desktop app's Capabilities -> Plugins form, or a secret manager.
# Full explanation: docs/credentials.md
#
# This file exists so the names and their meaning are discoverable in the repo.
# It contains no values and must never contain one. .env itself is gitignored.

# --- Required: Hermes prompts for these at install ----------------------------

# Long-lived user access token (60 days, refreshable).
# Scopes: threads_basic, threads_content_publish
# SECRET — masked on both the install prompt and the config UI, never logged.
THREADS_ACCESS_TOKEN=

# The spreadsheet id from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Needed in the environment (not only as a plugin setting) because the skill's
# standalone scripts run as sanitized terminal children — see docs/credentials.md.
AFFILIATE_SHEET_ID=

# --- Optional: working defaults, never block a load --------------------------

# Numeric Threads user id. Blank means the plugin resolves it from GET /me and
# caches it in plugin state.
THREADS_USER_ID=

# Tab holding the candidate table. Leave blank to use the default: Sheet1
AFFILIATE_SHEET_TAB=

# --- Optional plumbing overrides --------------------------------------------
# Absolute path to the google-workspace skill's google_api.py, when it lives
# somewhere non-standard.
# HERMES_GAPI_PATH=/home/me/.hermes/skills/productivity/google-workspace/scripts/google_api.py

# Command template used to invoke google_api.py. {python} and {script} are
# substituted. Default: "{python} {script}"
# HERMES_GAPI_COMMAND={python} {script}
